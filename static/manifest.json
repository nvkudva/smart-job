{
  "manifest_version": 3,
  "name": "SmartJob – AI Job Hunting Copilot",
  "version": "0.1.0",
  "description": "Job match analysis, salary insight, shortlist tracker and smart autofill for Workday, iCIMS, Greenhouse, LinkedIn and more. Works with local or cloud AI.",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Open SmartJob" },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["sidePanel", "storage", "unlimitedStorage", "tabs", "webNavigation", "scripting", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
